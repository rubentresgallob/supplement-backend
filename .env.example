# Copia este archivo a .env y rellénalo. El .env NUNCA se sube a git (.gitignore).

# --- Obligatorias ---
# PostgreSQL. Con Supabase usa el pooler en modo sesión (puerto 5432): las migraciones no funcionan en el 6543.
DATABASE_URL="postgresql://user:password@localhost:5432/supplement_db?schema=public"
# Clave para firmar los tokens. Sin ella el servidor no arranca. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- Opcionales ---
PORT=3000
# Orígenes extra permitidos por CORS, separados por comas (p. ej. la web en Firebase Hosting)
CORS_ORIGINS=""

# Plan Pro: apagado por defecto (sus rutas responden 404)
PRO_ENABLED=false
PRO_TEST_MODE=false

# Emails con Brevo (verificación y recuperar contraseña). Sin ellas, el código sale en el log del servidor.
BREVO_API_KEY=""
MAIL_FROM=""
MAIL_FROM_NAME="Supplement Tracker"
MAIL_DAILY_LIMIT=250
# Email al que llegan los avisos de denuncias de usuarios
ADMIN_EMAIL=""

# Push con Firebase Cloud Messaging: JSON de la cuenta de servicio en UNA línea. Sin ella no se envían push.
FIREBASE_SERVICE_ACCOUNT=""
