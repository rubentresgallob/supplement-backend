generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String
  username         String    @unique
  points           Int       @default(0) // Saldo de puntos (se mueve siempre junto a points_transaction)
  pro_until        DateTime? // Es Pro mientras pro_until > ahora
  pro_source       String? // "test" (modo de prueba) · "revenuecat" (pago real, más adelante)
  reset_code_hash  String? // Recuperar contraseña: código de 6 cifras (hasheado)
  reset_expires    DateTime?
  reset_attempts   Int       @default(0)
  share_with_friends Boolean @default(true) // (antiguo, ya no se usa) sustituido por share_progress y share_supplements
  // Privacidad por defecto (art. 25 RGPD): los dos interruptores empiezan apagados
  share_progress      Boolean   @default(false) // racha, % de 30 días, nº de suplementos y aparecer en la clasificación
  share_supplements   Boolean   @default(false) // nombre, dosis y forma de cada suplemento, tomas de hoy y calendario
  social_intro_seen_at DateTime? // vio la pantalla que explica qué ven sus amigos (1.ª solicitud)
  // Moderación (scripts/moderar.ts)
  suspended_at        DateTime? // cuenta suspendida: no puede iniciar sesión
  suspension_reason   String?
  consent_at       DateTime? // (antiguo) casilla única del registro anterior; ver los campos de abajo
  // RGPD: cada aceptación por separado, con fecha y versión del texto (src/legal/legal.ts)
  age_confirmed_at    DateTime? // "Tengo 18 años o más"
  terms_accepted_at   DateTime?
  terms_version       String?
  privacy_accepted_at DateTime?
  privacy_version     String?
  health_consent_at   DateTime? // Consentimiento explícito para datos de salud (art. 9 RGPD)
  email_verified   Boolean   @default(false) // Sin verificar no puede iniciar sesión; se borra a las 24 h
  verify_code_hash String? // Verificar email: código de 6 cifras (hasheado)
  verify_sent_at   DateTime? // Cuándo se envió el último código (para no reenviar en bucle)
  verify_attempts  Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user_supplements      user_supplement[]
  intakes               intake[]
  friendships_requested friendship[]         @relation("Requester")
  friendships_received  friendship[]         @relation("Receiver")
  notification_config   notification_config?
  points_transactions   points_transaction[]
  items                 user_item[]
  streak_freezes        streak_freeze[]
  push_tokens           push_token[]
  motivations_sent      motivation[]         @relation("MotivationSender")
  motivations_received  motivation[]         @relation("MotivationReceiver")
  sharing_events        sharing_event[]
  blocks_made           user_block[]         @relation("Blocker")
  blocks_received       user_block[]         @relation("Blocked")
  reports_made          user_report[]        @relation("Reporter")
  reports_received      user_report[]        @relation("Reported")
}

model supplement_database {
  id             Int      @id @default(autoincrement())
  name           String
  category       String
  forms          String[]
  typical_dosage String
  functions      String[]
  benefits       String[]
  notes          String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user_supplements user_supplement[]
}

model user_supplement {
  id                     Int      @id @default(autoincrement())
  user_id                Int
  supplement_database_id Int?
  custom_name            String?
  form                   String
  dosage_amount          Float
  dosage_unit            String
  times_per_day          Int
  schedules              String[] // Array of time strings like ["08:00", "14:00", "20:00"]
  active                 Boolean  @default(true)
  stock_units            Float? // Pro: unidades que quedan (null = sin control de stock)
  units_per_intake       Float    @default(1) // Unidades que se gastan en cada toma
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  deleted_at             DateTime? // Retirado por el usuario: no se borra, para conservar su historial

  user                user                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  supplement_database supplement_database? @relation(fields: [supplement_database_id], references: [id])
  intakes             intake[]

  @@index([user_id])
  @@index([supplement_database_id])
}

model intake {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  user_supplement_id Int
  taken_at           DateTime @default(now())
  created_at         DateTime @default(now())

  user            user            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_supplement user_supplement @relation(fields: [user_supplement_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_supplement_id])
  @@index([taken_at])
}

model friendship {
  id           Int      @id @default(autoincrement())
  requester_id Int
  receiver_id  Int
  status       String   @default("pending") // pending, accepted, rejected
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  requester user @relation("Requester", fields: [requester_id], references: [id], onDelete: Cascade)
  receiver  user @relation("Receiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@unique([requester_id, receiver_id])
  @@index([requester_id])
  @@index([receiver_id])
  @@index([status])
}

model notification_config {
  id                 Int      @id @default(autoincrement())
  user_id            Int      @unique
  global_enabled     Boolean  @default(true)
  supplement_configs String   @default("[]") // JSON string with array of configs
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Historial de puntos ganados (+) y gastados (-).
// `ref` identifica un premio único ("day:2026-10-01", "streak:7"...) para no darlo dos veces.
// Las compras van con ref = null (Postgres permite varios null en un unique).
model points_transaction {
  id         Int      @id @default(autoincrement())
  user_id    Int
  amount     Int
  reason     String
  ref        String?
  created_at DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, ref])
  @@index([user_id])
}

// Objetos del usuario. El catálogo vive en código (src/rewards/shop-catalog.ts).
model user_item {
  id          Int      @id @default(autoincrement())
  user_id     Int
  item_code   String
  quantity    Int      @default(1)
  equipped    Boolean  @default(false)
  acquired_at DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, item_code])
  @@index([user_id])
}

// Días cubiertos por un protector de racha (cuentan como completos para la racha).
model streak_freeze {
  id         Int      @id @default(autoincrement())
  user_id    Int
  day        String // "yyyy-MM-dd"
  created_at DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, day])
  @@index([user_id])
}

// Token de Firebase Cloud Messaging de cada móvil con la sesión iniciada (push reales)
model push_token {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique
  platform   String // android · ios
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// "Motivar" a un amigo: uno al día por pareja (para que no se convierta en spam)
model motivation {
  id          Int      @id @default(autoincrement())
  sender_id   Int
  receiver_id Int
  created_at  DateTime @default(now())

  sender   user @relation("MotivationSender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver user @relation("MotivationReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@index([sender_id, receiver_id, created_at])
}

// Historial de los interruptores de privacidad: cuándo se activó o desactivó cada uno
model sharing_event {
  id         Int      @id @default(autoincrement())
  user_id    Int
  setting    String // progress · supplements
  enabled    Boolean
  created_at DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// Bloqueos: se borra la amistad, no puede volver a enviar solicitudes y no se ven los perfiles
model user_block {
  id         Int      @id @default(autoincrement())
  blocker_id Int
  blocked_id Int
  created_at DateTime @default(now())

  blocker user @relation("Blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked user @relation("Blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocked_id])
}

// Denuncias (norma 1.2 de Apple / UGC de Google Play). Si el denunciante borra su cuenta,
// se borran sus denuncias; si la borra el denunciado, la denuncia queda anónima (reported_id = null).
model user_report {
  id          Int      @id @default(autoincrement())
  reporter_id Int
  reported_id Int?
  reason      String // offensive_name · impersonation · harassment · other
  details     String?
  status      String   @default("open") // open · closed
  created_at  DateTime @default(now())

  reporter user  @relation("Reporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported user? @relation("Reported", fields: [reported_id], references: [id], onDelete: SetNull)

  @@index([reporter_id])
  @@index([reported_id])
  @@index([status])
}
